---
import { AUTHOR, url } from '../consts';

const today = new Date();
---

<footer>
	<p>&copy; {today.getFullYear()} {AUTHOR}</p>
	<p class="links">
		<a href={url("/about")}>소개</a>
		<a href={url("/privacy")}>개인정보처리방침</a>
		<a href={url("/rss.xml")}>구독</a>
	</p>
</footer>
<style>
	footer {
		padding: 2em 1em 6em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
	}
	footer p {
		margin: 0.3em 0;
	}
	.links a {
		color: rgb(var(--gray));
		text-decoration: none;
		margin: 0 0.5em;
	}
	.links a:hover {
		color: rgb(var(--gray-dark));
		text-decoration: underline;
	}
</style>
